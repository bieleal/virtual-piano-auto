#Requires AutoHotkey v2.0
#SingleInstance Force

A_MaxHotkeysPerInterval := 500
A_HotkeyInterval := 2000

global seq := "", playing := false, pos := 1, tokens := [], tcount := 0
global STEP := 200, HOLD := 45, SPACEGAP := 45, BARGAP := 260, DASHGAP := 90
global pendingRelease := 0, TickFn := Tick.Bind(), ui := 0, speedLock := false, downKeys := Map(), nextDue := 0

global COLOR_BG := "121212", COLOR_PANEL := "1E1E1E", COLOR_TEXT := "cE0E0E0"
global COLOR_BTN := "2D2D2D", COLOR_BTN_PLAY := "2E7D32", COLOR_BTN_STOP := "C62828"

ApplyTempo()
BuildTokens()
InitUI()

IsTargetActive() => WinActive("A") && (!ui || !ui.Has("g") || WinActive("A") != ui["g"].Hwnd)

#HotIf IsTargetActive()
F1::TogglePlay()
End::StopAndReset()
[::PlayOne()
]::PlayOne()
#HotIf

#HotIf IsTargetActive() && !speedLock
~WheelUp:: ChangeSpeed(-10)
~WheelDown:: ChangeSpeed(10)
#HotIf

ChangeSpeed(delta) {
    global STEP += delta
    ApplyTempo()
    SafeRebuild(false)
}

TogglePlay() {
    global playing := !playing
    playing ? StartPlayback() : StopPlayback()
    SyncUIState()
}

StartPlayback() {
    global nextDue
    nextDue := A_TickCount
    SetTimer(TickFn, 10)
}

StopPlayback() => SetTimer(TickFn, 0)

ReleaseAllDown() {
    if (!downKeys.Count)
        return
    s := "{Blind}"
    for k, _ in downKeys
        s .= "{" k " up}"
    SendInput(s)
    downKeys.Clear()
}

StopAndReset() {
    global playing := false, pos := 1, pendingRelease := 0, nextDue := 0
    if (pendingRelease)
        SendChordUp(pendingRelease), pendingRelease := 0
    ReleaseAllDown()
    StopPlayback()
    SyncUIState()
}

SafeRebuild(resetToStart) {
    global playing, pendingRelease, pos, tcount
    wasPlaying := playing, playing := false
    StopPlayback()
    if (pendingRelease)
        SendChordUp(pendingRelease), pendingRelease := 0
    ReleaseAllDown()
    BuildTokens()
    pos := resetToStart ? 1 : Clamp(pos, 1, tcount + 1)
    SyncUIState()
    if (wasPlaying)
        playing := true, StartPlayback()
}

ApplyTempo() {
    global STEP, HOLD, SPACEGAP, BARGAP, DASHGAP
    STEP := Max(STEP, 15)
    SPACEGAP := Round(STEP * 0.30)
    DASHGAP := Round(STEP * 0.45)
    BARGAP := Round(STEP * 1.30)
    HOLD := Clamp(HOLD, 10, STEP - 5)
}

ParseChord(keys) {
    keys := Trim(keys)
    if (keys = "")
        return []
    out := [], seen := Map()
    parts := (InStr(keys, " ") || InStr(keys, ",")) ? StrSplit(RegExReplace(keys, "\s+", " "), [A_Space, ","]) : StrSplit(keys)
    for k in parts {
        k := Trim(k)
        if (k != "" && !seen.Has(k))
            seen[k] := 1, out.Push(k)
    }
    return out
}

PushWait(ms) {
    n := tokens.Length
    (n && tokens[n][1] = 1) ? tokens[n][2] += ms : tokens.Push([1, ms])
}

BuildTokens() {
    global seq, tokens, tcount, SPACEGAP, BARGAP, DASHGAP, pos
    tokens := [], i := 1, len := StrLen(seq)
    while (i <= len) {
        c := SubStr(seq, i, 1)
        if InStr("`r`n`t", c) {
            i++
            continue
        }
        if (c = "[") {
            j := InStr(seq, "]",, i + 1)
            if (!j) {
                tokens.Push([2, "["]), i++
                continue
            }
            chord := ParseChord(SubStr(seq, i + 1, j - i - 1))
            tokens.Push(chord.Length ? [3, chord] : [2, "[]"])
            i := j + 1
            continue
        }
        (c = " ") ? PushWait(SPACEGAP) : (c = "|") ? PushWait(BARGAP) : InStr("-–—", c) ? PushWait(DASHGAP) : tokens.Push([2, c])
        i++
    }
    tcount := tokens.Length
    pos := Clamp(pos, 1, tcount + 1)
}

ExpandKeyChar(ch, &needShift) {
    static sm := Map("!", "1", "@", "2", "#", "3", "$", "4", "%", "5", "^", "6", "&", "7", "*", "8", "(", "9", ")", "0", "_", "-", "+", "=", "{", "[", "}", "]", ":", ";", "<", ",", ">", ".", "?", "/", "|", "\")
    o := Ord(ch)
    if (o >= 65 && o <= 90)
        return (needShift := true, Chr(o + 32))
    if sm.Has(ch)
        return (needShift := true, sm[ch])
    return (needShift := false, ch)
}

ExpandChord(arr) {
    u := [], s := [], seenU := Map(), seenS := Map()
    for ch in arr {
        base := ExpandKeyChar(ch, &needShift)
        needShift ? (!seenS.Has(base) && (seenS[base] := 1, s.Push(base))) : (!seenU.Has(base) && (seenU[base] := 1, u.Push(base)))
    }
    return Map("u", u, "s", s, "h", (s.Length > 0))
}

SendKeyTap(k) {
    ReleaseAllDown()
    base := ExpandKeyChar(k, &needShift)
    if (needShift) {
        SendInput("{Blind}{Shift down}{" base "}{Shift up}")
        return
    }
    o := Ord(base)
    SendInput(((o >= 48 && o <= 57) || (o >= 65 && o <= 90) || (o >= 97 && o <= 122)) ? "{Blind}{" base "}" : "{Blind}" base)
}

SendChordDown(arr) {
    pack := ExpandChord(arr), out := "{Blind}"
    for k in pack["u"]
        downKeys[k] := 1, out .= "{" k " down}"
    if (pack["h"]) {
        downKeys["Shift"] := 1, out .= "{Shift down}"
        for k in pack["s"]
            downKeys[k] := 1, out .= "{" k " down}"
    }
    SendInput(out)
    return pack
}

SendChordUp(pack) {
    out := "{Blind}"
    if (pack["h"]) {
        for k in pack["s"]
            downKeys.Delete(k), out .= "{" k " up}"
        downKeys.Delete("Shift"), out .= "{Shift up}"
    }
    for k in pack["u"]
        downKeys.Delete(k), out .= "{" k " up}"
    SendInput(out)
}

Tick() {
    global playing, pos, tcount, tokens, STEP, HOLD, pendingRelease, nextDue
    if (!playing)
        return
    now := A_TickCount
    if (nextDue && now < nextDue)
        return
    if (pendingRelease) {
        pack := pendingRelease, pendingRelease := 0
        SendChordUp(pack)
        nextDue := now + STEP
        SyncUIState()
        return
    }
    if (pos > tcount) {
        StopAndReset()
        return
    }
    t := tokens[pos], pos++
    (t[1] = 1) ? (nextDue := now + t[2]) : (t[1] = 2) ? (SendKeyTap(t[2]), nextDue := now + STEP) : (pendingRelease := SendChordDown(t[2]), nextDue := now + HOLD)
    SyncUIState()
}

PlayOne() {
    global pos, tcount, tokens, pendingRelease
    if (pendingRelease)
        SendChordUp(pendingRelease), pendingRelease := 0
    ReleaseAllDown()
    while (pos <= tcount && tokens[pos][1] = 1)
        pos++
    if (pos > tcount)
        return SyncUIState()
    t := tokens[pos], pos++
    (t[1] = 2) ? SendKeyTap(t[2]) : SendChordUp(SendChordDown(t[2]))
    SyncUIState()
}

InitUI() {
    global ui, seq, STEP, HOLD, playing, speedLock

    g := Gui("+AlwaysOnTop", "Virtual Piano AUTO")
    ui := Map("g", g)
    g.BackColor := COLOR_BG
    g.SetFont("s10 " COLOR_TEXT)

    ui["edit"] := g.Add("Edit", "w580 h180 +WantTab -E0x200 Background" COLOR_PANEL " " COLOR_TEXT, seq)

    ; Botões Estilizados Coloridos
    btnApply := g.Add("Text", "w90 h30 y+10 Center +0x200 Background" COLOR_BTN " " COLOR_TEXT, "Aplicar")
    ui["btnPlay"] := g.Add("Text", "x+10 w90 h30 Center +0x200 Background" COLOR_BTN_PLAY " cWhite", "Iniciar")
    btnReset := g.Add("Text", "x+10 w90 h30 Center +0x200 Background" COLOR_BTN_STOP " cWhite", "Resetar")
    ui["lock"] := g.Add("CheckBox", "x+20 yp+4", "Bloquear Vel.")
    ui["lock"].Value := speedLock

    g.Add("Text", "xm y+15", "STEP:")
    ui["step"] := g.Add("Edit", "x+5 w60 Number -E0x200 Background" COLOR_PANEL " " COLOR_TEXT, STEP)
    ui["stepS"] := g.Add("Slider", "x+5 w150 Range15-800", STEP)

    g.Add("Text", "x+20", "HOLD:")
    ui["hold"] := g.Add("Edit", "x+5 w60 Number -E0x200 Background" COLOR_PANEL " " COLOR_TEXT, HOLD)
    ui["holdS"] := g.Add("Slider", "x+5 w130 Range10-780", HOLD)

    ui["statusProg"] := g.Add("Text", "xm y+15 w150", "Progresso: 0/0")
    ui["statusDesc"] := g.Add("Text", "x+10 w420", "| F1: Play/Pause | End: Reset | [ ou ]: Passo")

    btnApply.OnEvent("Click", (*) => UIApply())
    ui["btnPlay"].OnEvent("Click", (*) => TogglePlay())
    btnReset.OnEvent("Click", (*) => StopAndReset())
    ui["stepS"].OnEvent("Change", (*) => (ui["step"].Value := ui["stepS"].Value, UIApplyParams()))
    ui["holdS"].OnEvent("Change", (*) => (ui["hold"].Value := ui["holdS"].Value, UIApplyParams()))
    ui["lock"].OnEvent("Click", (*) => (speedLock := ui["lock"].Value, SyncUIState()))

    ; Encerramento limpo ao fechar a janela
    g.OnEvent("Close", (*) => CleanExit())

    val := 1
    DllCall("dwmapi\DwmSetWindowAttribute", "Ptr", g.Hwnd, "Int", 20, "Int*", val, "Int", 4)
    DllCall("dwmapi\DwmSetWindowAttribute", "Ptr", g.Hwnd, "Int", 19, "Int*", val, "Int", 4)

    g.Show()
    SyncUIState()
}

UIApply() {
    global seq := ui["edit"].Value
    UIApplyParams()
    SafeRebuild(true)
}

UIApplyParams() {
    global STEP := Integer(ui["step"].Value || STEP), HOLD := Integer(ui["hold"].Value || HOLD)
    ApplyTempo()
    ui["stepS"].Value := STEP, ui["holdS"].Value := HOLD
}

SyncUIState() {
    if (!ui || !ui.Has("btnPlay"))
        return
    ui["btnPlay"].Text := playing ? "Parar" : "Iniciar"
    ui["btnPlay"].Opt("Background" (playing ? COLOR_BTN_STOP : COLOR_BTN_PLAY))
    ui["statusProg"].Text := "Progresso: " (pos - 1) "/" tcount
}

CleanExit() {
    StopAndReset()
    ExitApp()
}

Clamp(val, minVal, maxVal) => Min(Max(val, minVal), maxVal)
